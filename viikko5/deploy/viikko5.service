[Unit]
Description=Viikko 5 Local LLM Chat Flask App
After=network.target mariadb.service ollama.service

[Service]
User=viikko5user
Group=viikko5user
WorkingDirectory=/opt/viikko5
EnvironmentFile=/etc/viikko5.env
EnvironmentFile=-/opt/viikko5/.commit_env
ExecStart=/opt/viikko5/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5005 app.main:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
